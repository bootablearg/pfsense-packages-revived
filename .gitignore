# Editor and OS noise
*.swp
*~
.DS_Store
Thumbs.db
.idea/
.vscode/

# Backups and local scratch
*.bak
*.orig
*.rej
*.log
/tmp/

# Never commit these: site-specific data or credentials
smb4.conf
krb5.conf
*.keytab
credentials*
*.pem
*.key

# Vendor originals used as reference. Several of these embed per-install
# license keys belonging to other people -- they must never reach a public
# repository. Keep reference material outside the working tree entirely;
# this is only a second line of defence.
pf2ad*.sh
*-reference/
_referencia*/

# Large reference documents
*.pdf

# Blacklist archive downloaded at runtime, not source.
shallalist.tar.gz
se-*.zip
