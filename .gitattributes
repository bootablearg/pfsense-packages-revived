# Everything in this repository is consumed by FreeBSD (pfSense), so line
# endings must be LF regardless of the platform a contributor works on.
# A CRLF in install.sh makes the shell fail with "bad interpreter", and a CRLF
# in the PHP or XML files breaks the package in ways that are tedious to trace.
* text=auto eol=lf

*.sh   text eol=lf
*.inc  text eol=lf
*.php  text eol=lf
*.xml  text eol=lf
*.md   text eol=lf

LICENSE text eol=lf
